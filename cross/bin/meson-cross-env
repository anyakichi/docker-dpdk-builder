#!/bin/bash

# Print the pkg-config environment that points into the sysroot, for the
# command line of meson setup.  Nothing is printed and the exit status is
# non-zero when there is no sysroot or pkg-config cannot be run in it, so that
# a build is never configured against an empty PKG_CONFIG_LIBDIR, which finds
# no library at all and drops most of DPDK without a word.

set -euo pipefail

# A native build has no sysroot to point into, whatever is left in WORKDIR.
if [[ -z ${CROSS_IMAGE:-} ]]; then
    exit 0
fi

SYSROOT=$WORKDIR/sysroot

if [[ ! -e $SYSROOT ]]; then
    echo "meson-cross-env: no sysroot in $WORKDIR; run extract first" >&2
    exit 1
fi

# The pc_path is asked of the sysroot's own pkg-config, since the directories
# are the distribution's, multiarch or lib64 or plain lib.
if ! pc_path=$(sudo chroot "$SYSROOT" pkg-config --variable pc_path pkg-config) ||
    [[ -z $pc_path ]]; then
    echo "meson-cross-env: cannot run pkg-config in $SYSROOT" >&2
    exit 1
fi

PKG_CONFIG_SYSROOT_DIR=$SYSROOT
PKG_CONFIG_LIBDIR=$(echo "$pc_path" | sed -E 's,(^|:),\1'"$SYSROOT"',g')
PKG_CONFIG_PATH="$SYSROOT/usr/local/lib/pkgconfig"

echo "PKG_CONFIG_SYSROOT_DIR=$PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_LIBDIR=$PKG_CONFIG_LIBDIR PKG_CONFIG_PATH=$PKG_CONFIG_PATH"
